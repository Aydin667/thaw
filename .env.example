# ── Thaw environment ─────────────────────────────────────────────
# Copy to .env.local for development. NEVER commit real values.

# Solana RPC (server-side only; the browser never talks to an RPC directly).
# A Helius endpoint is recommended: https://dashboard.helius.dev
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Platform keypair, base58-encoded 64-byte secret key.
# Used ONLY to: issue launch-certificate attestations, co-sign the mint
# keypair transaction, and receive the platform fee. Holds no user funds.
# Generate with: npm run gen:key  (see scripts/gen-key.mjs)
PLATFORM_KEYPAIR=

# Pinata (IPFS pinning for token image + metadata): https://app.pinata.cloud
PINATA_JWT=
# Your Pinata dedicated gateway domain, e.g. example-llama-123.mypinata.cloud
PINATA_GATEWAY=

# Jito block engine (bundle submission). Default: mainnet flagship.
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# Jito tip in lamports (default 1_000_000 = 0.001 SOL)
JITO_TIP_LAMPORTS=1000000

# Platform fee in lamports charged per launch (default 20_000_000 = 0.02 SOL)
PLATFORM_FEE_LAMPORTS=20000000

# Dry-run mode: "1" simulates the full launch pipeline against mainnet state
# without submitting anything. No SOL is spent; no token is created.
DRY_RUN=0

# Public site origin (canonical), used in metadata + share links.
# once the apex A/ALIAS record is in place and Render verifies it.
NEXT_PUBLIC_SITE_URL=https://thawlaunch.lol
